# The logis daemon, started by logis.socket. It needs WAYLAND_DISPLAY in the
# user manager's environment (niri and most session setups import it).
# It exits non-zero when the compositor goes away; the next connection to the
# socket starts it again, so it is not restarted here.

[Unit]
Description=logis machine spirit (launcher and dmenu daemon)
Documentation=https://github.com/nerdwave-nick/logis
Requires=logis.socket
After=logis.socket graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/logis daemon
# Stopping the service ends the daemon alone (owner decision, 2026-10-12):
# it never kills a provider, a launched app or a running servitor
# invocation. Apps run in scopes of their own where a user manager answers;
# KillMode=process also spares one started without a scope (or still being
# moved into one), a provider and the actions it started.
KillMode=process
