# Maintainer: nerdwave-nick <https://github.com/nerdwave-nick>
#
# logis is not in the AUR (AUR registrations are closed); this PKGBUILD lives
# in the repository instead. From a checkout:
#
#   cd packaging/arch && makepkg -si
#
# It builds the commit checked out in the repository that holds it (HEAD;
# uncommitted changes are not built), so the package is exactly one commit.
# To package a release, check out its tag (git checkout v0.1.1) first.
# prepare() finds that repository through makepkg's startdir, which namcap
# reports (file-referred-in-startdir): reading the checkout is the point here.
#
# The version comes from git, never from this file: _version is HEAD's
# `git describe --tags --match 'v[0-9]*'` without the "v" (0.1.1 at the tag
# v0.1.1, 0.1.1-3-gabc1234 three commits after it, 0.0.0-<commits>-g<hash>
# before the first tag), build() stamps it into the binary (`logis
# --version`) and package() into the man page; pkgver is its Arch form
# (0.1.1, 0.1.1.r3.gabc1234), which vercmp orders after the tag and before
# the next release. Both are computed here, from the checkout, and not in a
# pkgver() function: makepkg writes what pkgver() returns back into this
# tracked file, which would leave the checkout modified after every build.

_describe() {
  local d
  if d=$(git -C "$1" describe --tags --match 'v[0-9]*' 2>/dev/null); then
    printf '%s\n' "${d#v}"
  elif d=$(git -C "$1" rev-parse --short HEAD 2>/dev/null); then
    printf '0.0.0-%s-g%s\n' "$(git -C "$1" rev-list --count HEAD)" "$d"
  else
    printf '0.0.0\n'
  fi
}
_version=$(_describe "$startdir")
if [[ $_version =~ ^(.*)-([0-9]+)-g([0-9a-f]+)$ ]]; then
  _pkgver="${BASH_REMATCH[1]}.r${BASH_REMATCH[2]}.g${BASH_REMATCH[3]}"
else
  _pkgver=$_version
fi

pkgname=logis
pkgver=${_pkgver//-/_}
pkgrel=1
pkgdesc='A grimdark Wayland launcher and dmenu-compatible picker'
arch=('x86_64')
url='https://github.com/nerdwave-nick/logis'
license=('MIT')
# The binary links libwayland-client and libwayland-egl (wayland), libEGL and
# libGLESv2 (libglvnd), libfontconfig, libfreetype and libc. libglvnd
# dispatches to a vendor's EGL and OpenGL ES driver, whichever package
# provides opengl-driver: mesa (also llvmpipe, where no GPU serves),
# nvidia-utils, or another vendor's.
depends=(
  'fontconfig'
  'freetype2'
  'glibc'
  'libglvnd'
  'opengl-driver'
  'wayland'
)
makedepends=('git' 'go' 'pkgconf')
source=()
sha256sums=()

# The Go environment of every step (Arch's Go package guidelines): cgo
# compiles and links with makepkg's flags; the binary is a PIE linked by the
# system linker, without VCS stamps; modules come only from go.sum into a
# cache under $srcdir (removed with it), downloaded in prepare(); and the
# installed Go builds, never a downloaded toolchain. -trimpath (no build
# paths) is build()'s alone: tests find their fixtures through their own
# source path, which -trimpath would rewrite.
_goenv() {
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-buildmode=pie -buildvcs=false -ldflags=-linkmode=external -mod=readonly -modcacherw'
  export GOPATH="$srcdir/gopath"
  export GOTOOLCHAIN=local
}

prepare() {
  if (( ${#source[@]} == 0 )); then
    local repo
    rm -rf "$pkgname-$pkgver"
    repo=$(git -C "$startdir" rev-parse --show-toplevel)
    echo "logis: exporting HEAD of $repo ($(git -C "$repo" rev-parse --short HEAD), $_version)"
    git -C "$repo" archive --format=tar --prefix="$pkgname-$pkgver/" HEAD | tar -x
  fi
  cd "$pkgname-$pkgver"
  _goenv
  go mod download
}

build() {
  cd "$pkgname-$pkgver"
  _goenv
  export GOPROXY=off
  # -ldflags replaces GOFLAGS' -ldflags, so it repeats -linkmode=external.
  go build -trimpath \
    -ldflags "-linkmode=external -X github.com/nerdwave-nick/logis/internal/version.Version=$_version" \
    -o build/logis ./cmd/logis
}

check() {
  cd "$pkgname-$pkgver"
  _goenv
  export GOPROXY=off
  # Unit and process tests; no compositor is needed. The E2E and latency
  # tests run only under LOGIS_E2E and skip here, the GL tests skip where no
  # EGL display serves, and nothing may reach the session that runs makepkg.
  # -short skips the wall-clock timing tests (time limits and budgets) and
  # the GPU pixel tests (offscreen goldens and pixels read back): a busy
  # machine or another GPU driver must not fail the install on them. They
  # are for CI and development; CI and a plain `go test ./...` run them.
  env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET -u LOGIS_E2E -u LOGIS_REQUIRE_EGL \
    -u LOGIS_LATENCY_BUDGETS \
    go test -short ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/logis -t "$pkgdir/usr/bin"
  # The man page's title names logis; the package adds the version.
  install -dm755 "$pkgdir/usr/share/man/man1"
  sed "/^\.TH /s/ logis / \"logis $_version\" /" docs/man/logis.1 \
    >"$pkgdir/usr/share/man/man1/logis.1"
  chmod 644 "$pkgdir/usr/share/man/man1/logis.1"
  install -Dm644 contrib/completions/logis.bash "$pkgdir/usr/share/bash-completion/completions/logis"
  install -Dm644 contrib/completions/_logis -t "$pkgdir/usr/share/zsh/site-functions"
  install -Dm644 contrib/completions/logis.fish -t "$pkgdir/usr/share/fish/vendor_completions.d"
  # Shipped, not enabled: `systemctl --user enable --now logis.socket`.
  install -Dm644 contrib/systemd/logis.service contrib/systemd/logis.socket \
    -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 schema/logis.schema.json schema/theme.schema.json \
    -t "$pkgdir/usr/share/$pkgname/schema"
  install -Dm644 themes/*.jsonc -t "$pkgdir/usr/share/$pkgname/themes"
  install -Dm644 README.md CHANGELOG.md docs/provider-protocol.md \
    -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
