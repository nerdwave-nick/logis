# Maintainer: nerdwave-nick <https://github.com/nerdwave-nick>
#
# logis is not in the AUR (AUR registrations are closed); this PKGBUILD lives
# in the repository instead. From a checkout:
#
#   cd packaging/arch && makepkg -si
#
# It builds the commit checked out in the repository that holds it (HEAD;
# uncommitted changes are not built), so the package is exactly one commit.
# prepare() finds that repository through makepkg's startdir, which namcap
# reports (file-referred-in-startdir): reading the checkout is the point here.
#
# Once v$pkgver is tagged and pushed, build the tagged release instead:
# replace `source=()` and `sha256sums=()` below with
#
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
#   sha256sums=('<the output of: curl -L that URL | sha256sum>')
#
# The tarball unpacks to the same "$pkgname-$pkgver" directory that prepare()
# otherwise exports from the checkout afresh on every build.

pkgname=logis
pkgver=1.0.0
pkgrel=1
pkgdesc='A grimdark Wayland launcher and dmenu-compatible picker'
arch=('x86_64')
url='https://github.com/nerdwave-nick/logis'
license=('MIT')
# The binary links libwayland-client and libwayland-egl (wayland), libEGL and
# libGLESv2 (libglvnd), libfontconfig, libfreetype and libc. libglvnd
# dispatches to a vendor's EGL and OpenGL ES driver: mesa's (also llvmpipe,
# where no GPU serves), or another vendor's beside it.
depends=(
  'fontconfig'
  'freetype2'
  'glibc'
  'libglvnd'
  'mesa'
  'wayland'
)
makedepends=('git' 'go' 'pkgconf')
# None. Kept (empty) while the Rust reference lives on this branch: its
# tests/packaging.rs reads the array.
optdepends=()
source=()
sha256sums=()

# The Go environment of every step (Arch's Go package guidelines): cgo
# compiles and links with makepkg's flags; the binary is a PIE linked by the
# system linker, without build paths or VCS stamps; modules come only from
# go.sum into a cache under $srcdir (removed with it), downloaded in
# prepare(); and the installed Go builds, never a downloaded toolchain.
_goenv() {
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-buildmode=pie -trimpath -buildvcs=false -ldflags=-linkmode=external -mod=readonly -modcacherw'
  export GOPATH="$srcdir/gopath"
  export GOTOOLCHAIN=local
}

prepare() {
  if (( ${#source[@]} == 0 )); then
    local repo
    rm -rf "$pkgname-$pkgver"
    repo=$(git -C "$startdir" rev-parse --show-toplevel)
    echo "logis: exporting HEAD of $repo ($(git -C "$repo" rev-parse --short HEAD))"
    git -C "$repo" archive --format=tar --prefix="$pkgname-$pkgver/" HEAD | tar -x
  fi
  cd "$pkgname-$pkgver"
  if ! grep -qx "const Version = \"$pkgver\"" internal/version/version.go; then
    echo "logis: internal/version/version.go's Version is not $pkgver" >&2
    return 1
  fi
  _goenv
  go mod download
}

build() {
  cd "$pkgname-$pkgver"
  _goenv
  export GOPROXY=off
  go build -o build/logis ./cmd/logis
}

check() {
  cd "$pkgname-$pkgver"
  _goenv
  export GOPROXY=off
  # Unit, golden and process tests; no compositor is needed. The E2E and
  # latency tests run only under LOGIS_E2E and skip here, the GL tests skip
  # where no EGL display serves, and nothing may reach the session that runs
  # makepkg.
  env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET -u LOGIS_E2E -u LOGIS_REQUIRE_EGL \
    -u LOGIS_RUST_LOGIS -u LOGIS_LATENCY_BUDGETS \
    go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/logis -t "$pkgdir/usr/bin"
  install -Dm644 docs/man/logis.1 -t "$pkgdir/usr/share/man/man1"
  install -Dm644 contrib/completions/logis.bash "$pkgdir/usr/share/bash-completion/completions/logis"
  install -Dm644 contrib/completions/_logis -t "$pkgdir/usr/share/zsh/site-functions"
  install -Dm644 contrib/completions/logis.fish -t "$pkgdir/usr/share/fish/vendor_completions.d"
  # Shipped, not enabled: `systemctl --user enable --now logis.socket`.
  install -Dm644 contrib/systemd/logis.service contrib/systemd/logis.socket \
    -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 schema/logis.schema.json schema/theme.schema.json \
    -t "$pkgdir/usr/share/$pkgname/schema"
  install -Dm644 themes/*.jsonc -t "$pkgdir/usr/share/$pkgname/themes"
  install -Dm644 README.md CHANGELOG.md docs/provider-protocol.md \
    -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
