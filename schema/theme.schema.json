{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nerdwave-nick/logis/main/schema/theme.schema.json",
  "title": "logis theme",
  "description": "The vestments of the cogitator, kept as themes/<name>.jsonc beside logis.jsonc and chosen by its \"theme\". JSONC: comments and trailing commas are allowed. Every key is optional: what a theme leaves out comes from the theme it extends, then from the bundled forge-crimson-brass, whose values are the defaults below. Three layers: a palette of named colours, the elements that refer to it, and effects and motion. The machine spirit heeds edits at once; a theme it cannot read leaves the last sound one in force.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "The schema this theme is written against, for the editors of the faithful. logis accepts it and heeds it not.",
      "type": "string"
    },
    "extends": {
      "description": "Another theme (bundled, or a file in this directory) whose keys this one starts from; one level only. A theme extending its own name amends the bundled theme of that name.",
      "type": "string",
      "pattern": "^[^/.][^/]*$"
    },
    "palette": {
      "description": "Named colours: \"#rrggbb\" or \"#rrggbbaa\", or an array of them (named \"name.0\", \"name.1\" …). Everything else refers to them by name; \"error\" colours error notices.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            }
          }
        ]
      },
      "default": {
        "soot": [
          "#170e0b",
          "#0b0807"
        ],
        "brass": "#d4a017",
        "gold": "#f2c14e",
        "ember": "#c4651a",
        "crimson": "#b30f0d",
        "bone": "#f1e6cc",
        "parchment": "#d8c9ae",
        "ash": "#94836c",
        "smoke": "#6e5f4c",
        "umber": "#c9b894",
        "verdigris": "#8a6a14",
        "flare": "#ffe296",
        "band": [
          "#54140e",
          "#2e0d0a"
        ],
        "boss": "#0f0a08",
        "error": "#eb2919"
      }
    },
    "fonts": {
      "description": "Font roles by name; elements name a role. \"body\" is the default face.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/font"
      },
      "default": {
        "body": {
          "family": [
            "IBM Plex Mono",
            "monospace"
          ],
          "size": 16,
          "weight": 400,
          "tracking": 0
        },
        "query": {
          "family": [
            "IBM Plex Mono",
            "monospace"
          ],
          "size": 19,
          "weight": 400,
          "tracking": 0
        },
        "label": {
          "family": [
            "Cinzel",
            "serif"
          ],
          "size": 13,
          "weight": 600,
          "tracking": 0.2
        },
        "small": {
          "family": [
            "IBM Plex Mono",
            "monospace"
          ],
          "size": 13,
          "weight": 400,
          "tracking": 0.06
        },
        "badge": {
          "family": [
            "IBM Plex Mono",
            "monospace"
          ],
          "size": 11,
          "weight": 400,
          "tracking": 0.12
        }
      }
    },
    "window": {
      "description": "The window when the session asks for no size of its own.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "description": "The panel's width (border box) when no --width is given.",
          "$ref": "#/$defs/positive"
        },
        "height": {
          "description": "The panel's height when no --lines is given.",
          "$ref": "#/$defs/positive"
        },
        "rows": {
          "description": "The most rows shown at once when no --lines is given.",
          "type": "integer",
          "minimum": 1
        },
        "margin": {
          "description": "Room around the panel for its glow.",
          "$ref": "#/$defs/length"
        }
      },
      "default": {
        "width": 820,
        "height": 520,
        "rows": 9,
        "margin": 32
      }
    },
    "glow": {
      "description": "The glow around the panel.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "description": "Its colour at the edge; the alpha is its strength.",
          "$ref": "#/$defs/colour"
        },
        "radius": {
          "description": "How far it reaches.",
          "$ref": "#/$defs/length"
        },
        "pulse": {
          "description": "How far its strength swings (a continuous effect).",
          "$ref": "#/$defs/strength"
        },
        "period-ms": {
          "description": "One swing.",
          "$ref": "#/$defs/millis"
        }
      },
      "default": {
        "color": "crimson/0.55",
        "radius": 26,
        "pulse": 0.15,
        "period-ms": 3000
      }
    },
    "border": {
      "description": "The panel's edge.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "description": "Its width.",
          "$ref": "#/$defs/length"
        },
        "paint": {
          "description": "Top to bottom.",
          "$ref": "#/$defs/paint"
        },
        "highlight": {
          "description": "A bright spot travelling round the border (a continuous effect), or false.",
          "oneOf": [
            {
              "const": false,
              "description": "Off: not drawn."
            },
            {
              "description": "The travelling highlight.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "description": "Its colour at the centre.",
                  "$ref": "#/$defs/colour"
                },
                "length": {
                  "description": "Its reach along the border either side of its centre.",
                  "$ref": "#/$defs/length"
                },
                "period-ms": {
                  "description": "One round of the border.",
                  "$ref": "#/$defs/millis"
                }
              }
            }
          ]
        }
      },
      "default": {
        "width": 2,
        "paint": [
          "brass",
          "ember",
          "crimson"
        ],
        "highlight": {
          "color": "flare/0.9",
          "length": 70,
          "period-ms": 7000
        }
      }
    },
    "panel": {
      "description": "The panel's body.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "description": "Top to bottom; translucent colours let the blur show.",
          "$ref": "#/$defs/paint"
        },
        "radius": {
          "description": "Corner radius.",
          "$ref": "#/$defs/length"
        },
        "padding": {
          "description": "Left and right of the prompt line and the rows.",
          "$ref": "#/$defs/length"
        },
        "blur": {
          "description": "Blur behind the body (when the config's blur allows it and the compositor offers it).",
          "type": "boolean"
        }
      },
      "default": {
        "fill": [
          "soot.0/0.9",
          "soot.1/0.92"
        ],
        "radius": 14,
        "padding": 26,
        "blur": true
      }
    },
    "decorations": {
      "description": "Ornaments of the body.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rivets": {
          "description": "A rivet in each corner, or false.",
          "oneOf": [
            {
              "const": false,
              "description": "Off: not drawn."
            },
            {
              "description": "Corner rivets.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "description": "Their diameter.",
                  "$ref": "#/$defs/length"
                },
                "inset": {
                  "description": "From the body's edges.",
                  "$ref": "#/$defs/length"
                },
                "top": {
                  "description": "The upper pair, top-left to bottom-right.",
                  "$ref": "#/$defs/paint"
                },
                "bottom": {
                  "description": "The lower pair, top-left to bottom-right.",
                  "$ref": "#/$defs/paint"
                }
              }
            }
          ]
        }
      },
      "default": {
        "rivets": {
          "size": 6,
          "inset": 10,
          "top": [
            "#f2d27a",
            "#6b4a0c"
          ],
          "bottom": [
            "#c86a4a",
            "#4a0c08"
          ]
        }
      }
    },
    "prompt": {
      "description": "The start of the prompt line.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": {
          "description": "The prompt line's height, from the body's top to the rule.",
          "$ref": "#/$defs/positive"
        },
        "label": {
          "description": "A word before the session's prompt, \"\" for none.",
          "type": "string"
        },
        "font": {
          "description": "The label's font role.",
          "$ref": "#/$defs/role"
        },
        "color": {
          "description": "The label's and the session prompt's colour.",
          "$ref": "#/$defs/colour"
        },
        "gap": {
          "description": "Between the sigil, the label and the query.",
          "$ref": "#/$defs/length"
        },
        "sigil": {
          "description": "An image before the label, or false.",
          "oneOf": [
            {
              "const": false,
              "description": "Off: not drawn."
            },
            {
              "description": "The sigil.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "description": "\"gear\" (drawn by logis in its colour), or an SVG or PNG file relative to this theme's directory.",
                  "type": "string",
                  "minLength": 1,
                  "examples": [
                    "gear",
                    "sigils/skull.svg"
                  ]
                },
                "size": {
                  "description": "Its side.",
                  "$ref": "#/$defs/positive"
                },
                "color": {
                  "description": "The colour of a sigil logis draws.",
                  "$ref": "#/$defs/colour"
                }
              }
            }
          ]
        }
      },
      "default": {
        "height": 54,
        "label": "INVOKE",
        "font": "label",
        "color": "brass",
        "gap": 12,
        "sigil": {
          "image": "gear",
          "size": 20,
          "color": "brass"
        }
      }
    },
    "query": {
      "description": "What the user types.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "description": "Its font role.",
          "$ref": "#/$defs/role"
        },
        "color": {
          "description": "Its colour.",
          "$ref": "#/$defs/colour"
        },
        "placeholder": {
          "description": "The placeholder's colour.",
          "$ref": "#/$defs/colour"
        },
        "caret": {
          "description": "Where the next character goes.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "description": "A thin bar, a block or an underscore.",
              "enum": [
                "bar",
                "block",
                "underscore"
              ]
            },
            "width": {
              "description": "A bar's width (a block or an underscore is a character wide).",
              "$ref": "#/$defs/length"
            },
            "color": {
              "description": "Its colour.",
              "$ref": "#/$defs/colour"
            },
            "glow": {
              "description": "Its glow.",
              "$ref": "#/$defs/colour"
            }
          }
        }
      },
      "default": {
        "font": "query",
        "color": "bone",
        "placeholder": "smoke",
        "caret": {
          "shape": "bar",
          "width": 2,
          "color": "gold",
          "glow": "gold/0.8"
        }
      }
    },
    "counter": {
      "description": "How many items match.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "description": "Its font role.",
          "$ref": "#/$defs/role"
        },
        "color": {
          "description": "Its colour.",
          "$ref": "#/$defs/colour"
        },
        "format": {
          "description": "Its text; {matched} and {total} are replaced.",
          "type": "string"
        }
      },
      "default": {
        "font": "small",
        "color": "ash",
        "format": "{matched}/{total}"
      }
    },
    "rule": {
      "description": "The line under the prompt line.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paint": {
          "description": "Left to right.",
          "$ref": "#/$defs/paint"
        },
        "thickness": {
          "description": "Its thickness.",
          "$ref": "#/$defs/length"
        },
        "inset": {
          "description": "From the body's left and right edges.",
          "$ref": "#/$defs/length"
        },
        "dash": {
          "description": "Dash and gap lengths, or false for a solid line.",
          "oneOf": [
            {
              "const": false,
              "description": "Off: not drawn."
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/positive"
                },
                {
                  "$ref": "#/$defs/length"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "ornament": {
          "description": "A boss at the rule's middle, or false.",
          "oneOf": [
            {
              "const": false,
              "description": "Off: not drawn."
            },
            {
              "description": "The ornament.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "description": "Its diameter.",
                  "$ref": "#/$defs/length"
                },
                "fill": {
                  "description": "Its inside.",
                  "$ref": "#/$defs/colour"
                },
                "edge": {
                  "description": "Its edge.",
                  "$ref": "#/$defs/colour"
                }
              }
            }
          ]
        }
      },
      "default": {
        "paint": [
          "brass/0",
          "brass/0.85",
          "brass/0.85",
          "brass/0"
        ],
        "thickness": 1,
        "inset": 20,
        "dash": false,
        "ornament": {
          "size": 9,
          "fill": "boss",
          "edge": "brass"
        }
      }
    },
    "row": {
      "description": "A row of the list.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "description": "Its font role.",
          "$ref": "#/$defs/role"
        },
        "height": {
          "description": "From one row's top to the next.",
          "$ref": "#/$defs/positive"
        },
        "gap": {
          "description": "Above the first row and below the last.",
          "$ref": "#/$defs/length"
        },
        "padding": {
          "description": "From the body's left edge to the row's text.",
          "$ref": "#/$defs/length"
        },
        "columns": {
          "description": "Per tab-separated column; the last repeats.",
          "$ref": "#/$defs/colours"
        },
        "glyph": {
          "description": "An emblem's colour.",
          "$ref": "#/$defs/colour"
        },
        "column-gap": {
          "description": "Between one column's widest text and the next column. Columns are as wide as the widest text shown in them so far; the last takes the rest of the row.",
          "$ref": "#/$defs/length"
        },
        "column-max": {
          "description": "The most of the row's width a column other than the last may take; wider text ends in an ellipsis.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "default": {
        "font": "body",
        "height": 38,
        "gap": 12,
        "padding": 26,
        "columns": [
          "parchment",
          "brass",
          "ash"
        ],
        "glyph": "brass",
        "column-gap": 32,
        "column-max": 0.4
      }
    },
    "selection": {
      "description": "The selected row.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "band": {
          "description": "The band behind it, left to right.",
          "$ref": "#/$defs/paint"
        },
        "outline": {
          "description": "Lines above and below the band.",
          "$ref": "#/$defs/colour"
        },
        "edge": {
          "description": "The bar at the band's start (transparent for none).",
          "$ref": "#/$defs/colour"
        },
        "glow": {
          "description": "The band's glow (transparent for none).",
          "$ref": "#/$defs/colour"
        },
        "columns": {
          "description": "The selected row's column colours.",
          "$ref": "#/$defs/colours"
        },
        "inset": {
          "description": "From the body's left and right edges.",
          "$ref": "#/$defs/length"
        }
      },
      "default": {
        "band": [
          "band.0/0.92",
          "band.1/0.5"
        ],
        "outline": "crimson/0.55",
        "edge": "gold",
        "glow": "transparent",
        "columns": [
          "bone",
          "gold",
          "umber"
        ],
        "inset": 2
      }
    },
    "match": {
      "description": "Matched characters.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "description": "Their colour.",
          "$ref": "#/$defs/colour"
        },
        "selected": {
          "description": "Their colour on the selected row.",
          "$ref": "#/$defs/colour"
        },
        "weight": {
          "description": "Their weight (the row's families at this weight).",
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "underline": {
          "description": "Underline them.",
          "type": "boolean"
        }
      },
      "default": {
        "color": "gold",
        "selected": "gold",
        "weight": 600,
        "underline": false
      }
    },
    "badge": {
      "description": "Labels at a row's end.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "description": "Their font role.",
          "$ref": "#/$defs/role"
        },
        "style": {
          "description": "A pill with an edge, a filled pill, or the text in square brackets.",
          "enum": [
            "outline",
            "fill",
            "bracket"
          ]
        },
        "ink": {
          "description": "The text.",
          "$ref": "#/$defs/colour"
        },
        "edge": {
          "description": "An outline pill's edge.",
          "$ref": "#/$defs/colour"
        },
        "fill": {
          "description": "The pill's inside.",
          "$ref": "#/$defs/colour"
        },
        "uppercase": {
          "description": "Shout them.",
          "type": "boolean"
        }
      },
      "default": {
        "font": "badge",
        "style": "outline",
        "ink": "brass",
        "edge": "verdigris",
        "fill": "soot.1/0.9",
        "uppercase": true
      }
    },
    "pending": {
      "description": "A row whose data has not settled.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "description": "Its text.",
          "$ref": "#/$defs/colour"
        },
        "opacity": {
          "description": "The whole row's opacity.",
          "$ref": "#/$defs/strength"
        },
        "shimmer": {
          "description": "How far its mark's opacity swings (a continuous effect while one shows).",
          "$ref": "#/$defs/strength"
        },
        "period-ms": {
          "description": "One swing.",
          "$ref": "#/$defs/millis"
        },
        "mark": {
          "description": "What the row says at its end.",
          "type": "string"
        }
      },
      "default": {
        "color": "ash",
        "opacity": 0.72,
        "shimmer": 0.3,
        "period-ms": 1600,
        "mark": "divining…"
      }
    },
    "effects": {
      "description": "The CRT pass over the body: a group of settings per effect, each with its strength, where 0 is off. A bare number is the group's strength (the aberration's amount), so logis v1's themes stay valid; v1's bloom, curvature and vignette set glow.strength, roundness.curvature and roundness.vignette. Rolling scanlines, a wobbling aberration, changing grain and flicker move on their own; reduce-motion stills them. The groups diverge from logis v1's seven strengths.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scanlines": {
          "description": "Dark lines across the glass; a bare number is their strength.",
          "oneOf": [
            {
              "$ref": "#/$defs/strength"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "description": "How dark the lines get; 0 is off.",
                  "$ref": "#/$defs/strength"
                },
                "period": {
                  "description": "Logical pixels from one line to the next, counted from the body's top (v1: 3).",
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16
                },
                "sharpness": {
                  "description": "How thin and hard each line is: 0 a soft wave, 0.25 v1's profile, 1 a hard line one pixel thick.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "roll": {
                  "description": "Drift in logical pixels per second, downwards when positive; 0 holds them still (v1). A continuous effect.",
                  "type": "number",
                  "minimum": -60,
                  "maximum": 60
                }
              }
            }
          ]
        },
        "glow": {
          "description": "Light from bright parts spreading to their surroundings (v1's bloom); a bare number is its strength.",
          "oneOf": [
            {
              "$ref": "#/$defs/strength"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "description": "How much light spreads; 0 is off.",
                  "$ref": "#/$defs/strength"
                },
                "threshold": {
                  "description": "Brightness per channel below which nothing glows (v1: 0.35).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "reach": {
                  "description": "Radius of the outer sampling ring in logical pixels, the inner ring at 3/7 of it; beyond 9 more rings keep a wide halo soft (v1: 7).",
                  "type": "number",
                  "minimum": 1,
                  "maximum": 32
                },
                "bleed": {
                  "description": "How much of the source colour the light keeps: 0 a neutral halo, 1 the bright pixels' own colours (v1), above 1 more saturated.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                },
                "dim-bright": {
                  "description": "0: every pixel takes the same glow (v1). Towards 1 dim pixels take up to 1.7 times as much and bright ones, or those inside filled bright bands, only 0.15 times: text gets a halo without washing out a highlighted row.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "aberration": {
          "description": "Red and blue sampled either side of green (chromatic aberration); a bare number is its amount.",
          "oneOf": [
            {
              "$ref": "#/$defs/strength"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "description": "The offset: 2 logical pixels at 1; 0 is off.",
                  "$ref": "#/$defs/strength"
                },
                "edges-only": {
                  "description": "0: the same horizontal offset everywhere (v1); 1: none at the centre, growing outwards and pointing away from it.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "wobble": {
                  "description": "How much the offset varies over time; 0 keeps it steady (v1). A continuous effect.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "wobble-rate": {
                  "description": "How fast the wobble runs, in Hz.",
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 20
                },
                "twitch": {
                  "description": "The wobble's character: 0 a smooth breathing, 1 calm with sudden short spikes at irregular moments.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "mask": {
          "description": "A CRT's phosphor structure over the picture; a bare number is its strength.",
          "oneOf": [
            {
              "$ref": "#/$defs/strength"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "description": "How much the structure darkens; 0 is off (v1).",
                  "$ref": "#/$defs/strength"
                },
                "size": {
                  "description": "Its pitch in logical pixels: one dot cell, or one red-green-blue triad.",
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16
                },
                "kind": {
                  "description": "dots: a soft round dot grid; grille: vertical red, green and blue stripes; slot: those stripes broken into slots, every other column shifted like brickwork.",
                  "enum": [
                    "dots",
                    "grille",
                    "slot"
                  ]
                }
              }
            }
          ]
        },
        "roundness": {
          "description": "The curved tube face.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "curvature": {
              "description": "How far the whole panel bows out as one tube face: border, glass and the glow around it bend together, the outline turns convex and every effect lies on the bent glass. 0 is flat. v1 bent only the picture behind a straight border.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "corners": {
              "description": "Extra rounding of the visible glass's corners on the bent glass; beyond them the screen is black. 0 is off (v1).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "vignette": {
              "description": "Darkening towards the glass's corners; 0 is off.",
              "$ref": "#/$defs/strength"
            }
          }
        },
        "grain": {
          "description": "Film grain; a bare number is its strength.",
          "oneOf": [
            {
              "$ref": "#/$defs/strength"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "description": "How strong the noise is; 0 is off.",
                  "$ref": "#/$defs/strength"
                },
                "rate": {
                  "description": "How many times a second it changes (v1: 24); 0 freezes it. Changing grain is a continuous effect.",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 60
                }
              }
            }
          ]
        },
        "flicker": {
          "description": "The brightness trembling (keep it subtle); a bare number is its strength. A continuous effect.",
          "oneOf": [
            {
              "$ref": "#/$defs/strength"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "description": "How deep the trembling is; 0 is off.",
                  "$ref": "#/$defs/strength"
                },
                "frequency": {
                  "description": "Its main rate in Hz, with a slower irregular modulation riding on it (v1: 7.4802823, 47 radians a second).",
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 30
                }
              }
            }
          ]
        },
        "vignette": {
          "description": "logis v1's name of roundness.vignette; give one of the two.",
          "deprecated": true,
          "$ref": "#/$defs/strength"
        },
        "bloom": {
          "description": "logis v1's name of glow.strength; give one of the two.",
          "deprecated": true,
          "$ref": "#/$defs/strength"
        },
        "curvature": {
          "description": "logis v1's name of roundness.curvature; give one of the two.",
          "deprecated": true,
          "$ref": "#/$defs/strength"
        }
      },
      "default": {
        "scanlines": {
          "strength": 0.38,
          "period": 2,
          "sharpness": 0.79,
          "roll": 0.5
        },
        "glow": {
          "strength": 0.26,
          "threshold": 0.25,
          "reach": 1.5,
          "bleed": 0.65,
          "dim-bright": 0.55
        },
        "aberration": {
          "amount": 0.06,
          "edges-only": 0.13,
          "wobble": 0.33,
          "wobble-rate": 1.65,
          "twitch": 0.29
        },
        "mask": {
          "strength": 0.04,
          "size": 2,
          "kind": "dots"
        },
        "roundness": {
          "curvature": 0.02,
          "corners": 0,
          "vignette": 0.14
        },
        "grain": {
          "strength": 0.12,
          "rate": 24
        },
        "flicker": {
          "strength": 0.01,
          "frequency": 7.48
        }
      }
    },
    "motion": {
      "description": "Transition timings. LOGIS_MOTION and reduce-motion do not change them; reduce-motion stills only continuous effects.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "open-ms": {
          "description": "The open transition.",
          "$ref": "#/$defs/millis"
        },
        "close-ms": {
          "description": "The close transition.",
          "$ref": "#/$defs/millis"
        },
        "select-ms": {
          "description": "The selection band's glide.",
          "$ref": "#/$defs/millis"
        }
      },
      "default": {
        "open-ms": 150,
        "close-ms": 110,
        "select-ms": 90
      }
    }
  },
  "$defs": {
    "colour": {
      "description": "A colour: \"#rrggbb\", \"#rrggbbaa\", \"transparent\", or a palette name (\"brass\"; \"soot.1\" for the second colour of a palette entry), optionally followed by \"/alpha\" from 0 to 1, which multiplies its alpha (\"crimson/0.55\").",
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|transparent|[a-z][a-z0-9_-]*(\\.[0-9]+)?)(/(0|1|0\\.[0-9]+|1\\.0+))?$",
      "examples": [
        "#d4a017",
        "#2e0d0a80",
        "brass",
        "soot.1",
        "crimson/0.55",
        "transparent"
      ]
    },
    "paint": {
      "description": "One colour, or 1 to 4 colours as evenly spaced gradient stops. Each element says which way its gradient runs.",
      "oneOf": [
        {
          "$ref": "#/$defs/colour"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/colour"
          }
        }
      ]
    },
    "colours": {
      "description": "Colours per column; the last repeats for further columns.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/colour"
      }
    },
    "length": {
      "description": "Logical pixels (the renderer multiplies by the output's scale).",
      "type": "number",
      "minimum": 0
    },
    "positive": {
      "description": "Logical pixels, more than 0.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "strength": {
      "description": "A strength from 0 (off) to 1.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "millis": {
      "description": "Milliseconds; 0 stills it.",
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "description": "The name of a font role in \"fonts\".",
      "type": "string",
      "minLength": 1
    },
    "families": {
      "description": "Font families in order of preference, resolved by fontconfig (aliases and generic families such as monospace, serif and sans-serif included). A family that is not installed falls through to the next.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "font": {
      "description": "A font role: families, size, weight and letter spacing.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "description": "Families, the most wanted first; the last is usually generic.",
          "$ref": "#/$defs/families"
        },
        "size": {
          "description": "The em in logical pixels.",
          "$ref": "#/$defs/positive"
        },
        "weight": {
          "description": "The OpenType weight: 400 regular, 600 semibold, 700 bold.",
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "tracking": {
          "description": "Letter spacing in ems.",
          "type": "number",
          "minimum": -0.5,
          "maximum": 1
        }
      }
    }
  },
