// Cogitator phosphor: a green CRT (spec §4.9). Curved glass, bloom,
// scanlines and grain; the selection is inverse video, matches are
// underlined. Whatever is left out comes from forge-crimson-brass.
{
  "$schema": "../schema/theme.schema.json",
  "palette": {
    "void": "#020904",
    "glass": ["#061a0c", "#000301"],
    "dim": "#1f9e4c",
    "edge": "#2fd36a",
    "text": "#36d96a",
    "phosphor": "#46ff7a",
    "faint": "#7fe89c",
    "hot": "#c8ffd6",
    "ink": "#021006",
    "error": "#ff5a3c"
  },
  "fonts": {
    "body": { "family": ["VT323", "Terminus", "monospace"], "size": 24, "weight": 400, "tracking": 0 },
    "query": { "family": ["VT323", "Terminus", "monospace"], "size": 28, "weight": 400, "tracking": 0 },
    "label": { "family": ["VT323", "Terminus", "monospace"], "size": 28, "weight": 400, "tracking": 0 },
    "small": { "family": ["VT323", "Terminus", "monospace"], "size": 22, "weight": 400, "tracking": 0 },
    "badge": { "family": ["VT323", "Terminus", "monospace"], "size": 24, "weight": 400, "tracking": 0 }
  },
  "glow": { "color": "edge/0.35", "radius": 20, "pulse": 0.1, "period-ms": 4000 },
  "border": { "width": 1, "paint": "edge", "highlight": false },
  "panel": { "fill": ["glass.0/0.95", "glass.1/0.98"], "radius": 26, "padding": 34, "blur": true },
  "decorations": { "rivets": false },
  "prompt": { "height": 58, "label": "SUMMON>", "font": "label", "color": "edge", "gap": 14, "sigil": false },
  "query": {
    "font": "query",
    "color": "phosphor",
    "placeholder": "dim",
    "caret": { "shape": "block", "width": 12, "color": "phosphor", "glow": "phosphor/0.8" }
  },
  "counter": { "font": "small", "color": "dim", "format": "[{matched}/{total}]" },
  "rule": { "paint": "dim", "thickness": 2, "inset": 30, "dash": [8, 6], "ornament": false },
  "row": {
    "font": "body",
    "height": 38,
    "gap": 12,
    "padding": 34,
    "columns": ["text", "phosphor", "dim"],
    "glyph": "phosphor",
    "column-gap": 28
  },
  "selection": {
    "band": "phosphor",
    "outline": "transparent",
    "edge": "transparent",
    "glow": "phosphor/0.55",
    "columns": ["ink"],
    "inset": 22
  },
  "match": { "color": "hot", "selected": "ink", "weight": 400, "underline": true },
  "badge": {
    "font": "body",
    "style": "bracket",
    "ink": "phosphor",
    "edge": "transparent",
    "fill": "transparent",
    "uppercase": true
  },
  "tab": { "radius": 4 },
  "pending": { "color": "dim", "opacity": 1, "shimmer": 0.5, "period-ms": 1200, "mark": "▒▒▒ AUGURING" },
  // The owner's look from the effects lab (2026-10-16): heavy scanlines
  // rolling up, a strong phosphor glow, a breathing colour split, grain
  // and a slightly bent tube.
  "effects": {
    "scanlines": { "strength": 0.8, "period": 3, "sharpness": 0.47, "roll": -2 },
    "glow": { "strength": 0.63, "threshold": 0.54, "reach": 1.5, "bleed": 0.9, "dim-bright": 0.15 },
    "aberration": { "amount": 0.62, "edges-only": 0, "wobble": 0.08, "wobble-rate": 1.9, "twitch": 0 },
    "mask": { "strength": 0.04, "size": 2, "kind": "dots" },
    "roundness": { "curvature": 0.06, "corners": 0, "vignette": 0.21 },
    "grain": { "strength": 0.55, "rate": 24 },
    "flicker": { "strength": 0.06, "frequency": 3.49 },
    // The owner's glitch from the effects lab (2026-10-16): stronger,
    // shorter episodes with flashing slices, longer bursts, fewer random
    // ones; a small burst on each key press (key-ms, key-strength).
    "glitch": {
      "strength": 0.73,
      "episodes": { "period-s": 9, "duty": 0.05 },
      "wobble": { "rest": 0.2, "episode": 24, "band-px": 26, "speed-hz": 24 },
      "tracking": { "px": 3, "height-px": 3, "a-hz": 0.43, "b-hz": 0.29 },
      "fringe": { "px": 0.5, "growth": 0.12 },
      "slices": { "rest": 0, "episode": 0.24, "px": 9, "shift-px": 40, "group": 5, "rate-hz": 30 },
      "blocks": { "rest": 0, "episode": 0.45, "size": 1, "shift-px": 26, "split-px": 3, "brightness": 0.4, "rate-hz": 30 },
      "flashes": { "rest": 0.05, "episode": 0.52, "gain": 0.33, "rate-hz": 30 },
      "noise-band": { "rest": 0.02, "episode": 0.43, "cell-px": 1, "min": 0.03, "max": 0.1, "rate-hz": 30 },
      "static": { "rest": 0.03, "episode": 0.07, "rate-hz": 30 },
      "line-pulse": { "rest": 0.09, "episode": 0.12, "pitch-px": 2.3, "drift-px-s": 6 },
      "bursts": { "open-ms": 500, "tab-ms": 280, "key-ms": 120, "key-strength": 0.3, "random-per-minute": 3.5, "random-ms": 300, "stutter": 0.28, "on": ["open", "tab", "key"] }
    }
  }
}
