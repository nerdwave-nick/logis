// Forge crimson & brass: the default look of logis (spec §4.9), after the
// research spike (research/evidence/spike.png): a soot-dark translucent
// panel, a brass-to-crimson border with a travelling highlight, a pulsing
// crimson glow, scanlines, grain and a subtle flicker.
//
// This theme gives every key: any other theme falls back to it for what it
// leaves out. Lengths are logical pixels, durations milliseconds, strengths
// 0 to 1. Original motifs only (a generic gear, corner rivets).
{
  "$schema": "../schema/theme.schema.json",
  "palette": {
    "soot": ["#170e0b", "#0b0807"],
    "brass": "#d4a017",
    "gold": "#f2c14e",
    "ember": "#c4651a",
    "crimson": "#b30f0d",
    "bone": "#f1e6cc",
    "parchment": "#d8c9ae",
    "ash": "#94836c",
    "smoke": "#6e5f4c",
    "umber": "#c9b894",
    "verdigris": "#8a6a14",
    "flare": "#ffe296",
    "band": ["#54140e", "#2e0d0a"],
    "boss": "#0f0a08",
    "error": "#eb2919"
  },
  "fonts": {
    "body": { "family": ["IBM Plex Mono", "monospace"], "size": 16, "weight": 400, "tracking": 0 },
    "query": { "family": ["IBM Plex Mono", "monospace"], "size": 19, "weight": 400, "tracking": 0 },
    "label": { "family": ["Cinzel", "serif"], "size": 13, "weight": 600, "tracking": 0.2 },
    "small": { "family": ["IBM Plex Mono", "monospace"], "size": 13, "weight": 400, "tracking": 0.06 },
    "badge": { "family": ["IBM Plex Mono", "monospace"], "size": 11, "weight": 400, "tracking": 0.12 }
  },
  "window": { "width": 820, "rows": 11, "margin": 32 },
  "glow": { "color": "crimson/0.55", "radius": 26, "pulse": 0.15, "period-ms": 3000 },
  "border": {
    "width": 2,
    "paint": ["brass", "ember", "crimson"],
    "highlight": { "color": "flare/0.9", "length": 70, "period-ms": 7000 }
  },
  "panel": { "fill": ["soot.0/0.9", "soot.1/0.92"], "radius": 14, "padding": 26, "blur": true },
  "decorations": {
    "rivets": { "size": 6, "inset": 10, "top": ["#f2d27a", "#6b4a0c"], "bottom": ["#c86a4a", "#4a0c08"] }
  },
  "prompt": {
    "height": 54,
    "label": "INVOKE",
    "font": "label",
    "color": "brass",
    "gap": 12,
    "sigil": { "image": "gear", "size": 20, "color": "brass" }
  },
  "query": {
    "font": "query",
    "color": "bone",
    "placeholder": "smoke",
    "caret": { "shape": "bar", "width": 2, "color": "gold", "glow": "gold/0.8" }
  },
  "counter": { "font": "small", "color": "ash", "format": "{matched}/{total}" },
  "rule": {
    "paint": ["brass/0", "brass/0.85", "brass/0.85", "brass/0"],
    "thickness": 1,
    "inset": 20,
    "dash": false,
    "ornament": { "size": 9, "fill": "boss", "edge": "brass" }
  },
  "row": {
    "font": "body",
    "height": 38,
    "gap": 12,
    "padding": 26,
    "columns": ["parchment", "brass", "ash"],
    "glyph": "brass",
    "column-gap": 32,
    "column-max": 0.4
  },
  "selection": {
    "band": ["band.0/0.92", "band.1/0.5"],
    "outline": "crimson/0.55",
    "edge": "gold",
    "glow": "transparent",
    "columns": ["bone", "gold", "umber"],
    "inset": 2
  },
  "match": { "color": "gold", "selected": "gold", "weight": 600, "underline": false },
  "badge": {
    "font": "badge",
    "style": "outline",
    "ink": "brass",
    "edge": "verdigris",
    "fill": "soot.1/0.9",
    "uppercase": true
  },
  // plain logis's tab plates (the rest of their look echoes the
  // selection, the panel, the label and the badges)
  "tab": { "radius": 9 },
  "pending": { "color": "ash", "opacity": 0.72, "shimmer": 0.3, "period-ms": 1600, "mark": "divining…" },
  // The owner's look from the effects lab (2026-10-15): fine rolling
  // scanlines, a faint dot mask, a soft glow, a hint of twitching
  // aberration and a barely bent tube.
  "effects": {
    "scanlines": { "strength": 0.38, "period": 2, "sharpness": 0.79, "roll": 0.5 },
    "glow": { "strength": 0.26, "threshold": 0.25, "reach": 1.5, "bleed": 0.65, "dim-bright": 0.55 },
    "aberration": { "amount": 0.06, "edges-only": 0.13, "wobble": 0.33, "wobble-rate": 1.65, "twitch": 0.29 },
    "mask": { "strength": 0.04, "size": 2, "kind": "dots" },
    "roundness": { "curvature": 0.02, "corners": 0, "vignette": 0.14 },
    "grain": { "strength": 0.12, "rate": 24 },
    "flicker": { "strength": 0.01, "frequency": 7.48 },
    // The owner's glitch from the effects lab (2026-10-15): calm at rest,
    // a breakup at the end of every 9 s, a burst on opening and on a
    // switch of tab, and six random bursts a minute; a small one on each
    // key press (key-ms, key-strength).
    "glitch": {
      "strength": 0.45,
      "episodes": { "period-s": 9, "duty": 0.1 },
      "wobble": { "rest": 0.2, "episode": 24, "band-px": 26, "speed-hz": 24 },
      "tracking": { "px": 3, "height-px": 3, "a-hz": 0.43, "b-hz": 0.29 },
      "fringe": { "px": 0.5, "growth": 0.12 },
      "slices": { "rest": 0, "episode": 0.12, "px": 9, "shift-px": 40, "group": 5, "rate-hz": 30 },
      "blocks": { "rest": 0, "episode": 0.45, "size": 1, "shift-px": 26, "split-px": 3, "brightness": 0.4, "rate-hz": 30 },
      "flashes": { "rest": 0, "episode": 0.06, "gain": 0.33, "rate-hz": 30 },
      "noise-band": { "rest": 0.02, "episode": 0.3, "cell-px": 1, "min": 0.03, "max": 0.1, "rate-hz": 30 },
      "static": { "rest": 0.03, "episode": 0.07, "rate-hz": 30 },
      "line-pulse": { "rest": 0.03, "episode": 0.12, "pitch-px": 2.3, "drift-px-s": 6 },
      "bursts": { "open-ms": 420, "tab-ms": 240, "key-ms": 120, "key-strength": 0.3, "random-per-minute": 6, "random-ms": 300, "stutter": 0.28, "on": ["open", "tab", "key"] }
    }
  },
  "motion": { "open-ms": 150, "close-ms": 110, "select-ms": 90 }
}
